# Empty VITE_API_URL means frontend calls the same origin and Vite proxies /api
# to VITE_PROXY_TARGET. Set this to a full backend URL only when needed.
VITE_API_URL=
VITE_HOST=0.0.0.0
VITE_PORT=3001
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Set VITE_HTTPS=1 to serve dev over HTTPS (uses vite-plugin-mkcert).
# First run will install a local CA — accept the OS prompt.
VITE_HTTPS=

VITE_SHEET_ENDPOINT=/api/sheet/append
VITE_SPREADSHEET_ID=
